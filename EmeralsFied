                TweenService:Create(Knob, TweenInfo.new(0.18), {
                    Position = State and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
                }):Play()
            end

            Frame.MouseButton1Click:Connect(function()
                State = not State
                UpdateVisual()
                Callback(State)
            end)

