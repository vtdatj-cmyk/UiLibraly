        function TabObj:CreateSlider(Cfg)
            local Name = Cfg.Name or "Slider"
            local Min = Cfg.Range and Cfg.Range[1] or 0
            local Max = Cfg.Range and Cfg.Range[2] or 100
            local Inc = Cfg.Increment or 1
            local Suffix = Cfg.Suffix or ""
            local Value = Cfg.CurrentValue or Min
            local Callback = Cfg.Callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 46)
            Frame.BackgroundColor3 = Theme.Element
            Frame.BackgroundTransparency = 0.25
            Frame.Parent = Page
            AddCorner(Frame, 6)
            AddBorder(Frame, Theme.Stroke, 0.55)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -80, 0, 20)
            Label.Position = UDim2.new(0, 10, 0, 4)
            Label.BackgroundTransparency = 1
            Label.Text = Name
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 12
            Label.TextColor3 = Theme.TextMain
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame
            ApplyTextOutline(Label, 1.1, 0.28)

            local ValLabel = Instance.new("TextLabel")
            ValLabel.Size = UDim2.new(0, 70, 0, 20)
            ValLabel.Position = UDim2.new(1, -78, 0, 4)
            ValLabel.BackgroundTransparency = 1
            ValLabel.Text = tostring(Value) .. Suffix
            ValLabel.Font = Enum.Font.GothamBold
            ValLabel.TextSize = 11
            ValLabel.TextColor3 = Theme.AccentBright
            ValLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValLabel.Parent = Frame
            ApplyTextOutline(ValLabel, 1.1, 0.25)

            local Track = Instance.new("TextButton")
            Track.Size = UDim2.new(1, -20, 0, 6)
            Track.Position = UDim2.new(0, 10, 0, 30)
            Track.BackgroundColor3 = Color3.fromRGB(8, 24, 17)
            Track.Text = ""
            Track.AutoButtonColor = false
            Track.Parent = Frame
            AddCorner(Track, 3)

            local Fill = Instance.new("Frame")
            local initPct = math.clamp((Value - Min) / (Max - Min), 0, 1)
            Fill.Size = UDim2.new(initPct, 0, 1, 0)
            Fill.BackgroundColor3 = Theme.Accent
            Fill.BorderSizePixel = 0
            Fill.Parent = Track
            AddCorner(Fill, 3)

            local Sliding = false
            local function UpdateSlider(inputPos)
                local pct = math.clamp((inputPos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local raw = Min + (Max - Min) * pct
                local stepped = math.floor(raw / Inc + 0.5) * Inc
                Value = math.clamp(tonumber(string.format("%.2f", stepped)), Min, Max)
                local finalPct = (Value - Min) / (Max - Min)
                Fill.Size = UDim2.new(finalPct, 0, 1, 0)
                ValLabel.Text = tostring(Value) .. Suffix
                Callback(Value)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Sliding = true
                    UpdateSlider(input.Position)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input.Position)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Sliding = false
                end
            end)
        end

