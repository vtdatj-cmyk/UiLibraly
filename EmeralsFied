            local Viewport = Instance.new("ViewportFrame")
            Viewport.Size = UDim2.new(1, -16, 0, Height)
            Viewport.Position = UDim2.new(0, 8, 0, 27)
            Viewport.BackgroundColor3 = Color3.fromRGB(6, 20, 14)
            Viewport.BackgroundTransparency = 0.3
            Viewport.Parent = Frame
            AddCorner(Viewport, 5)
            AddBorder(Viewport, Theme.Stroke, 0.4)

            local light = Instance.new("DirectionalLight")
            light.Color = Color3.fromRGB(255, 255, 255)
            light.Parent = Viewport

            local camera = Instance.new("Camera")
            Viewport.CurrentCamera = camera
            camera.Parent = Viewport

            if Model and Model:IsA("Model") then
                local cloneModel = Model:Clone()
                cloneModel.Parent = Viewport

                local cf, size = cloneModel:GetBoundingBox()
                local maxDim = math.max(size.X, size.Y, size.Z)
                local distance = maxDim * 2.2

                camera.CFrame = CFrame.new(cf.Position + Vector3.new(distance, distance * 0.6, distance), cf.Position)

                if AutoRotate then
                    task.spawn(function()
                        local angle = 0
                        while cloneModel and cloneModel.Parent do
                            angle = angle + 0.015
                            local offset = CFrame.Angles(0, angle, 0) * Vector3.new(distance, distance * 0.6, distance)
                            camera.CFrame = CFrame.new(cf.Position + offset, cf.Position)
                            task.wait(0.03)
                        end
                    end)
                end
            end
        end

