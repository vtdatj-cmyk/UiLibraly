    -- =========================================================================
    -- TÍCH HỢP: TỰ ĐỘNG KHỞI TẠO TAB SETTING NẰM Ở CUỐI CÙNG
    -- =========================================================================
    local function BuildSettingTab()
        if SettingTabCreated then return end
        SettingTabCreated = true

        local SettingTab = CreateTabInternal(L("Settings"), true)

        -- 1. Mục tùy chỉnh Giao diện
        SettingTab:CreateSection(L("SecTheme"))

        -- Đổi màu nền (Color Picker chủ đạo)
        local colorThemes = {
            {Name = "Emerald (Mặc định)", Dark = Color3.fromRGB(9, 33, 22), Mid = Color3.fromRGB(16, 58, 38), Light = Color3.fromRGB(22, 82, 54), Accent = Color3.fromRGB(16, 185, 129), AccentBright = Color3.fromRGB(52, 211, 153)},
            {Name = "Ruby Blue (Xanh/Đỏ)", Dark = Color3.fromRGB(20, 24, 33), Mid = Color3.fromRGB(35, 42, 64), Light = Color3.fromRGB(50, 60, 95), Accent = Color3.fromRGB(59, 130, 246), AccentBright = Color3.fromRGB(96, 165, 250)},
            {Name = "Cyberpunk (Neon Dark)", Dark = Color3.fromRGB(25, 12, 35), Mid = Color3.fromRGB(50, 22, 68), Light = Color3.fromRGB(75, 33, 102), Accent = Color3.fromRGB(236, 72, 153), AccentBright = Color3.fromRGB(244, 114, 182)},
            {Name = "Sunset Orange (Cam ấm)", Dark = Color3.fromRGB(35, 20, 10), Mid = Color3.fromRGB(68, 38, 18), Light = Color3.fromRGB(102, 58, 27), Accent = Color3.fromRGB(245, 158, 11), AccentBright = Color3.fromRGB(251, 191, 36)},
            {Name = "Minimal Dark (Xám tối)", Dark = Color3.fromRGB(18, 18, 18), Mid = Color3.fromRGB(32, 32, 32), Light = Color3.fromRGB(48, 48, 48), Accent = Color3.fromRGB(200, 200, 200), AccentBright = Color3.fromRGB(255, 255, 255)}
        }

        local themeDropdownOptions = {}
        for _, tObj in ipairs(colorThemes) do
            table.insert(themeDropdownOptions, tObj.Name)
        end

        -- Thêm Dropdown đổi màu nền
        -- (Dùng cơ chế tạo thủ công hoặc input/dropdown có sẵn)
        SettingTab:CreateDropdown({
            Name = L("BgColor"),
            Options = themeDropdownOptions,
            CurrentOption = themeDropdownOptions[1],
            Callback = function(selectedName)
                for _, th in ipairs(colorThemes) do
                    if th.Name == selectedName then
                        Theme.BgDark = th.Dark
                        Theme.BgMid = th.Mid
                        Theme.BgLight = th.Light
                        Theme.Accent = th.Accent
                        Theme.AccentBright = th.AccentBright
                        -- Làm mới gradient Main Frame
                        ApplyEmeraldGradient(Main, 135)
                        ApplyEmeraldGradient(Topbar, 135)
                        break
                    end
                end
            end
        })

        -- 2. Đổi nền sang Nhập ảnh (Custom Image Background ID)
        SettingTab:CreateInput({
            Name = L("BgImage"),
            PlaceholderText = "Nhập Asset ID (vd: 6023426915)...",
            Callback = function(text)
                if text and text ~= "" then
                    if tonumber(text) then
                        BgImageLayer.Image = "rbxassetid://" .. text
                    else
                        BgImageLayer.Image = text
                    end
                else
                    BgImageLayer.Image = ""
                end
            end
        })

        -- 3. Mục Dữ liệu & Hệ thống
        SettingTab:CreateSection(L("SecData"))

        -- Nút Bật/Tắt SaveData (Tự động lưu & Tự bật lại script khi rejoin)
        local saveToggle = SettingTab:CreateToggle({
            Name = L("SaveData"),
            CurrentValue = (pcall(function() return readfile("EmeraldField_SaveState.json") end) and true or false),
            Callback = function(state)
                local success, err = pcall(function()
                    if state then
                        writefile("EmeraldField_SaveState.json", HttpService:JSONEncode({SaveEnabled = true, Timestamp = os.time()}))
                        WindowObj:Notify({Title = L("NotifyTitle"), Content = L("NotifySaveOn"), Duration = 3})
                    else
                        if isfile and isfile("EmeraldField_SaveState.json") then
                            delfile("EmeraldField_SaveState.json")
                        end
                        WindowObj:Notify({Title = L("NotifyTitle"), Content = L("NotifySaveOff"), Duration = 3})
                    end
                end)
                if not success then
                    -- Trường hợp executor không hỗ trợ writefile/readfile cục bộ
                    WindowObj:Notify({Title = "Notice", Content = "Executor không hỗ trợ ghi tệp SaveData nội bộ!", Duration = 3})
                end
            end
        })

        -- 4. Mục Ngôn ngữ (Dịch Tiếng Anh & Tiếng Việt - Mặc định Tiếng Việt)
        SettingTab:CreateSection(L("SecLang"))

        SettingTab:CreateToggle({
            Name = L("LangToggle") .. " (English / Tiếng Việt)",
            CurrentValue = (CurrentLanguage == "EN"),
            Callback = function(isEnglish)
                CurrentLanguage = isEnglish and "EN" or "VN"
                WindowObj:Notify({
                    Title = L("NotifyTitle"),
                    Content = isEnglish and L("NotifyLangEN") or L("NotifyLangVN"),
                    Duration = 3
                })
            end
        })
    end

    -- Tự động gọi khởi tạo tab Setting ngay sau khi thiết lập cửa sổ
    task.spawn(function()
        BuildSettingTab()
    end)

    return WindowObj
end

