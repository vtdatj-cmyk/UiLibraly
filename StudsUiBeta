            ValLabel.Position = UDim2.new(1, -87, 0, 5)
            ValLabel.BackgroundTransparency = 1
            ValLabel.Text = tostring(Value) .. Suffix
            ValLabel.Font = Enum.Font.GothamBold
            ValLabel.TextSize = 12
            ValLabel.TextColor3 = Theme.AccentBright
            ValLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValLabel.Parent = Frame
            ApplyTextOutline(ValLabel, 1.1, 0.25)

            local Track = Instance.new("TextButton")
            Track.Size = UDim2.new(1, -24, 0, 8)
            Track.Position = UDim2.new(0, 12, 0, 34)
            Track.BackgroundColor3 = Color3.fromRGB(8, 24, 17)
            Track.Text = ""
            Track.AutoButtonColor = false
            Track.Parent = Frame
            AddCorner(Track, 4)

            local Fill = Instance.new("Frame")
            local initPct = math.clamp((Value - Min) / (Max - Min), 0, 1)
            Fill.Size = UDim2.new(initPct, 0, 1, 0)
            Fill.BackgroundColor3 = Theme.Accent
            Fill.BorderSizePixel = 0
            Fill.Parent = Track
            AddCorner(Fill, 4)

            local Sliding = false
            local function UpdateSlider(inputPos)
                local pct = math.clamp((inputPos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local raw = Min + (Max - Min) * pct
                local stepped = math.floor(raw / Inc + 0.5) * Inc
                Value = math.clamp(tonumber(string.format("%.2f", stepped)), Min, Max)
                local finalPct = (Value - Min) / (Max - Min)
                Fill.Size = UDim2.new(finalPct, 0, 1, 0)
                ValLabel.Text = tostring(Value) .. Suffix
                Callback(Value)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Sliding = true
                    UpdateSlider(input.Position)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input.Position)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Sliding = false
                end
            end)
        end

