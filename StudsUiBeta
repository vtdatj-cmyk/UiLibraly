    EmeraldField UI Library (Rayfield Inspired)
    Theme: Emerald & Soft Dark Green Gradient + Soft Black Text Stroke
    Compatible with Mobile & PC Executors
]]

local EmeraldField = {}

local TweenService = game:GetService("TweenService")
