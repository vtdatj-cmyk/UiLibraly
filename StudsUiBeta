local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

-- Hàm bảo vệ GUI tránh bị phát hiện cơ bản
local function getGuiParent()
    local success, result = pcall(function()
        return gethui and gethui() or CoreGui
    end)
    if success and result then
        return result
    end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- Bảng màu chuẩn Emerald Theme
local Theme = {
    BgDark = Color3.fromRGB(9, 33, 22),       -- #092116 Xanh lá đậm nhẹ
    BgMid = Color3.fromRGB(16, 58, 38),       -- #103a26 Xanh lá trung bình
    BgLight = Color3.fromRGB(22, 82, 54),     -- #165236 Xanh ngọc lục bảo
    Element = Color3.fromRGB(14, 46, 31),     -- Nền ô chức năng
    ElementHover = Color3.fromRGB(20, 66, 44),
    Accent = Color3.fromRGB(16, 185, 129),    -- #10b981 Emerald sáng
    AccentBright = Color3.fromRGB(52, 211, 153),
    Stroke = Color3.fromRGB(45, 130, 90),
    TextMain = Color3.fromRGB(240, 253, 244),
    TextSub = Color3.fromRGB(167, 243, 208),
    BlackStroke = Color3.fromRGB(4, 12, 8)
}

-- Hàm tạo viền đen dịu cho chữ
local function ApplyTextOutline(textLabel, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.BlackStroke
    stroke.Thickness = thickness or 1.2
    stroke.Transparency = transparency or 0.28
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    stroke.Parent = textLabel
    return stroke
end

-- Hàm tạo nền Gradient Xanh lá
local function ApplyEmeraldGradient(frame, rotation)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.BgDark),
        ColorSequenceKeypoint.new(0.55, Theme.BgMid),
        ColorSequenceKeypoint.new(1, Theme.BgLight)
    })
    gradient.Rotation = rotation or 135
    gradient.Parent = frame
    return gradient
end

-- Hàm bo góc
local function AddCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = instance
    return corner
end

-- Hàm viền khung
local function AddBorder(instance, color, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Theme.Stroke
    stroke.Thickness = 1
    stroke.Transparency = transparency or 0.55
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = instance
    return stroke
end

-- Hàm hỗ trợ kéo thả (PC & Mobile)
local function MakeDraggable(topBar, mainFrame)
    local dragging, dragInput, dragStart, startPos
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TweenService:Create(mainFrame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

