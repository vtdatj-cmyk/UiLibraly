            AddBorder(Frame, Theme.Stroke, 0.55)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, -12, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = Name
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Theme.TextMain
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame
            ApplyTextOutline(Label, 1.1, 0.28)

            local Box = Instance.new("TextBox")
            Box.Size = UDim2.new(0.5, -16, 0, 26)
            Box.Position = UDim2.new(0.5, 6, 0.5, -13)
            Box.BackgroundColor3 = Color3.fromRGB(8, 25, 17)
            Box.Text = ""
            Box.PlaceholderText = Placeholder
            Box.PlaceholderColor3 = Color3.fromRGB(110, 170, 140)
            Box.Font = Enum.Font.Gotham
            Box.TextSize = 12
            Box.TextColor3 = Theme.TextMain
            Box.ClearTextOnFocus = false
            Box.Parent = Frame
            AddCorner(Box, 6)
            AddBorder(Box, Theme.Stroke, 0.5)
            ApplyTextOutline(Box, 1, 0.35)

            Box.FocusLost:Connect(function()
                Callback(Box.Text)
            end)
        end

        -- 6. DROPDOWN (Menu thả xuống)
        function TabObj:CreateDropdown(Cfg)
            local Name = Cfg.Name or "Dropdown"
            local Options = Cfg.Options or {"Lựa chọn 1", "Lựa chọn 2"}
            local Current = Cfg.CurrentOption or Options[1]
            local Callback = Cfg.Callback or function() end
            local Open = false

            local Container = Instance.new("Frame")
            Container.Size = UDim2.new(1, 0, 0, 38)
            Container.BackgroundColor3 = Theme.Element
            Container.BackgroundTransparency = 0.25
            Container.ClipsDescendants = true
            Container.Parent = Page
            AddCorner(Container, 8)
            AddBorder(Container, Theme.Stroke, 0.55)

            local Header = Instance.new("TextButton")
            Header.Size = UDim2.new(1, 0, 0, 38)
            Header.BackgroundTransparency = 1
            Header.Text = ""
            Header.Parent = Container

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.55, 0, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = Name
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Theme.TextMain
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Header
            ApplyTextOutline(Label, 1.1, 0.28)

            local SelectedLabel = Instance.new("TextLabel")
            SelectedLabel.Size = UDim2.new(0.45, -16, 1, 0)
            SelectedLabel.Position = UDim2.new(0.55, 4, 0, 0)
            SelectedLabel.BackgroundTransparency = 1
            SelectedLabel.Text = tostring(Current) .. "  ▼"
            SelectedLabel.Font = Enum.Font.GothamSemibold
            SelectedLabel.TextSize = 12
            SelectedLabel.TextColor3 = Theme.AccentBright
            SelectedLabel.TextXAlignment = Enum.TextXAlignment.Right
            SelectedLabel.Parent = Header
            ApplyTextOutline(SelectedLabel, 1.1, 0.28)

            local ListFrame = Instance.new("Frame")
            ListFrame.Size = UDim2.new(1, -16, 0, #Options * 28)
            ListFrame.Position = UDim2.new(0, 8, 0, 40)
            ListFrame.BackgroundTransparency = 1
            ListFrame.Parent = Container

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.Padding = UDim.new(0, 4)
            ListLayout.Parent = ListFrame

            for _, opt in ipairs(Options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Size = UDim2.new(1, 0, 0, 24)
                OptBtn.BackgroundColor3 = Color3.fromRGB(9, 28, 19)
                OptBtn.Text = "  " .. tostring(opt)
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextSize = 12
                OptBtn.TextColor3 = Theme.TextMain
                OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                OptBtn.Parent = ListFrame
                AddCorner(OptBtn, 5)
                ApplyTextOutline(OptBtn, 1, 0.32)

                OptBtn.MouseButton1Click:Connect(function()
                    Current = opt
                    SelectedLabel.Text = tostring(Current) .. "  ▼"
                    Open = false
                    TweenService:Create(Container, TweenInfo.new(0.18), {Size = UDim2.new(1, 0, 0, 38)}):Play()
                    Callback(Current)
                end)
            end

            Header.MouseButton1Click:Connect(function()
                Open = not Open
                local targetH = Open and (46 + (#Options * 28)) or 38
                SelectedLabel.Text = tostring(Current) .. (Open and "  ▲" or "  ▼")
                TweenService:Create(Container, TweenInfo.new(0.18), {Size = UDim2.new(1, 0, 0, targetH)}):Play()
            end)
        end

        -- 7. KEYBIND (Gán phím tắt)
        function TabObj:CreateKeybind(Cfg)
            local Name = Cfg.Name or "Keybind"
            local CurrentKey = Cfg.CurrentKeybind or Enum.KeyCode.RightControl
            local Callback = Cfg.Callback or function() end
            local Listening = false

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Theme.Element
            Frame.BackgroundTransparency = 0.25
            Frame.Parent = Page
            AddCorner(Frame, 8)
            AddBorder(Frame, Theme.Stroke, 0.55)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -100, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = Name
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Theme.TextMain
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame
            ApplyTextOutline(Label, 1.1, 0.28)

            local KeyBtn = Instance.new("TextButton")
            KeyBtn.Size = UDim2.new(0, 82, 0, 24)
            KeyBtn.Position = UDim2.new(1, -92, 0.5, -12)
            KeyBtn.BackgroundColor3 = Color3.fromRGB(8, 25, 17)
            KeyBtn.Text = CurrentKey.Name
            KeyBtn.Font = Enum.Font.GothamBold
            KeyBtn.TextSize = 11
            KeyBtn.TextColor3 = Theme.AccentBright
            KeyBtn.Parent = Frame
            AddCorner(KeyBtn, 6)
            AddBorder(KeyBtn, Theme.Stroke, 0.45)
            ApplyTextOutline(KeyBtn, 1, 0.3)

            KeyBtn.MouseButton1Click:Connect(function()
                Listening = true
                KeyBtn.Text = "..."
            end)

            UserInputService.InputBegan:Connect(function(input, gp)
                if Listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    CurrentKey = input.KeyCode
                    KeyBtn.Text = CurrentKey.Name
                    Listening = false
                elseif not gp and not Listening and input.KeyCode == CurrentKey then
                    Callback(CurrentKey)
                end
            end)
        end

        -- 8. COLOR PICKER (Bộ chọn màu nhanh)
        function TabObj:CreateColorPicker(Cfg)
            local Name = Cfg.Name or "Color Picker"
            local Colors = {
                Color3.fromRGB(16, 185, 129),  -- Emerald
                Color3.fromRGB(52, 211, 153),  -- Mint
                Color3.fromRGB(59, 130, 246),  -- Blue
                Color3.fromRGB(239, 68, 68),   -- Red
                Color3.fromRGB(245, 158, 11),  -- Amber
                Color3.fromRGB(255, 255, 255)  -- White
            }
            local idx = 1
            local Callback = Cfg.Callback or function() end

            local Frame = Instance.new("TextButton")
            Frame.Size = UDim2.new(1, 0, 0, 38)
            Frame.BackgroundColor3 = Theme.Element
            Frame.BackgroundTransparency = 0.25
            Frame.Text = ""
            Frame.AutoButtonColor = false
            Frame.Parent = Page
            AddCorner(Frame, 8)
            AddBorder(Frame, Theme.Stroke, 0.55)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -60, 1, 0)
            Label.Position = UDim2.new(0, 12, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = Name .. " (Bấm đổi màu)"
            Label.Font = Enum.Font.GothamMedium
            Label.TextSize = 13
            Label.TextColor3 = Theme.TextMain
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame
            ApplyTextOutline(Label, 1.1, 0.28)

            local Preview = Instance.new("Frame")
            Preview.Size = UDim2.new(0, 26, 0, 22)
            Preview.Position = UDim2.new(1, -38, 0.5, -11)
            Preview.BackgroundColor3 = Colors[idx]
            Preview.Parent = Frame
            AddCorner(Preview, 6)
            AddBorder(Preview, Theme.TextMain, 0.3)

            Frame.MouseButton1Click:Connect(function()
                idx = (idx % #Colors) + 1
                Preview.BackgroundColor3 = Colors[idx]
                Callback(Colors[idx])
            end)
        end

        return TabObj
    end

    return WindowObj
end

return EmeraldField
